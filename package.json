{
  "name": "zaoba-survival",
  "version": "1.0.0",
  "description": "早八生存局：今天翘不翘？课堂多人博弈游戏",
  "scripts": {
    "dev": "concurrently -k -n server,vite \"tsx watch server/index.ts\" \"vite\"",
    "build": "npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:bundle": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --minify --outfile=server-dist/bundle.mjs --banner:js=\"import { createRequire as __createRequire } from 'node:module'; const require = __createRequire(import.meta.url);\" --external:bufferutil --external:utf-8-validate",
    "start": "NODE_ENV=production node server-dist/index.js",
    "preview": "NODE_ENV=production node server-dist/index.js",
    "test": "tsx scripts/test-game.ts",
    "smoke": "tsx scripts/smoke.ts",
    "loadtest": "tsx scripts/load-test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.scripts.json --noEmit"
  },
  "keywords": [
    "game-theory",
    "bayesian-nash-equilibrium",
    "classroom-game",
    "teaching-tool"
  ],
  "author": "Loi Chyan",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "express": "^5.3.0",
    "katex": "^0.19.1",
    "motion": "^14.14.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/express": "^5.0.6",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=22"
  }
}
